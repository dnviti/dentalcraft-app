turntable-cal-progress = Calibrating: move { $n }
turntable-cal-quality-good = Good fit
turntable-cal-quality-fair = Fair fit
turntable-cal-quality-poor = Poor fit
turntable-cal-residuals = Error of the fit: { $deg }° of turn, { $mm } mm of axis position.
turntable-cal-pairs = Stop pairs registered: { $pairs } of { $expected }.
turntable-cal-gain = Measured turn over commanded turn: { $gain }.
turntable-cal-poor-hint = The fit is too loose for a steady scan. Calibrate again with a still object with some shape, and a slower turn.
scan-roi = Keep only the platter
scan-roi-hint = Points outside a cylinder around the axis of the turntable are left out, so the box around the turntable does not move the scan.
scan-roi-radius = Distance from the axis
scan-roi-height = Height above the platter
scan-auto-title = Automatic scan
scan-auto-needs = Connect a turntable for an automatic scan.
scan-auto-arch = Arch (−20/0/+20)
scan-auto-quick = Quick (0)
scan-auto-custom = Custom
scan-auto-tilts = Tilts, in degrees, separated by commas
